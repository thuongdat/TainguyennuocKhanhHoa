# Mau bien moi truong cho backend trung gian QTQG.
# Sao thanh .env roi dien gia tri that:   cp .env.mau .env
# .env da nam trong .gitignore nen khong bao gio bi commit.
# Tep mau nay CO commit, vi vay moi gia tri bi mat de rong.

# Che do lay so lieu:  thu_nghiem (mac dinh, khong can CSDL) | that
CHE_DO=thu_nghiem

# CSDL Quan trac Quoc gia. De rong trong tep mau.
QTQG_MAY_CHU=
QTQG_CONG=5432
QTQG_CSDL=
QTQG_TAI_KHOAN=
QTQG_MAT_KHAU=

# Cong dich vu. De trong thi lay cong.backend trong tinh.json (khuyen dung):
# moi tinh mot cap cong rieng, Khanh Hoa 8000/8001, Gia Lai 8010/8011.
CONG=

# Cac nguon duoc phep goi API, phan cach bang dau phay.
# De trong thi tu suy tu cong.web trong tinh.json. Len may chu that thi them
# ten mien vao day.
CORS_NGUON=

# So giay giu ket qua trong bo nho dem, cung la lop bao ve CSDL QTQG
CACHE_GIAY=60

# Tep sqlite tich luy chuoi thoi gian, duong dan tuong doi so voi backend/
DUONG_DAN_SQLITE=chuoi_quan_trac.sqlite3

# Uoc nhiet do nuoc tu trung binh nhieu nam cung thang cua chinh tram, dung khi
# ky do thieu so do nhiet do. Can cho viec quy DO ra phan tram bao hoa; thieu
# no thi nhom IV thuong khong du ba thong so va WQI khong du dieu kien cong bo.
# Day la so SUY DIEN, moi ban ghi dung no deu mang co nhiet_do_uoc_tinh.
# Dat 0 de tat.
UOC_NHIET_DO=1

# Hop danh sach tram dia phuong (data/quan_trac.geojson) vao danh sach tram
# QTQG o che do that. Du an nay TAT, vi lop quan trac dia phuong hien con la
# du lieu mo phong. Dat 1 khi tinh co lop quan trac dia phuong that.
HOP_TRAM_DIA_PHUONG=0

# An ban ghi so do cu hon bao nhieu NGAY. Mac dinh 730, tuc 2 nam.
# Loc o day la BAN GHI SO DO, khong phai cong trinh: tram van hien tren ban do
# va trong bang, chi la khong co so do di kem. Dat 0 de tat.
SO_DO_CU_TOI_DA_NGAY=730
